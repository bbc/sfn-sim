{
  "name": "sfn-sim",
  "version": "2.0.1",
  "description": "AWS Step Functions simulator for unit testing state machines",
  "keywords": [
    "aws",
    "step-functions",
    "state-machine",
    "testing"
  ],
  "author": "Ben Wormald <ben.wormald@bbc.co.uk>",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bbc/sfn-sim.git"
  },
